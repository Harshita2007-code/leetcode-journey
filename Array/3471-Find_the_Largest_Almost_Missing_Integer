class Solution {
public:
    int largestInteger(vector<int>& nums, int k) {
        int n = nums.size();
        unordered_map <int,int> mp;
        for(int i=0; i<n; i++){
            mp[nums[i]]++;
        }

        if(k==1){
            int ans = -1;
            for(int i=0; i<mp.size(); i++){
                if(mp[i]==1){
                    ans = max(ans, i);
                }
            }
            return ans;
        }

        if(n==k){
            int maxint = INT_MIN;
            for(int a=0; a<n; a++){
                maxint = max(maxint, nums[a]);
            }
            return maxint;
        }

        int ans = -1;
        if(mp[nums[0]]==1){
            ans = max(ans, nums[0]);
        }
        if(mp[nums[n-1]]==1){
            ans = max(ans, nums[n-1]);
        }

        return ans;
    }
};